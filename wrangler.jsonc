{
	"name": "opus-transcriber-proxy",
	"main": "worker/index.ts",
	"compatibility_date": "2025-01-09",
	// nodejs_compat: the Worker-hosted /translate path runs the Emscripten Opus glue, which expects
	// some Node globals.
	// enable_ctx_exports: @cloudflare/containers (0.2+) reaches its ContainerProxy entrypoint through
	// `ctx.exports` whenever a container Durable Object is rebuilt around an already-running container,
	// even with outbound interception unused; without the flag (default on only from compatibility
	// date 2025-11-17) that is an unhandled rejection logged on every deploy and eviction.
	"compatibility_flags": ["nodejs_compat", "enable_ctx_exports"],
	"observability": {
		"enabled": true
	},
	// Exposes the deployed Worker version (id/tag/timestamp) at runtime via the CF_VERSION_METADATA
	// binding. Used to augment the `info` message forwarded to the client for observability.
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"containers": [
		{
			"image": "./Dockerfile",
			"class_name": "TranscriberContainer",
			"name": "transcriber",
			// Default max instances (overridden per environment)
			"max_instances": 2
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "TranscriberContainer",
				"name": "TRANSCRIBER"
			}
			// Uncomment to enable WebSocket connection to Dispatcher DO (avoids subrequest limit)
			// {
			// 	"name": "DISPATCHER_DO",
			// 	"class_name": "TranscriptionDispatcherDO",
			// 	"script_name": "transcription-dispatcher"
			// }
		]
	},
	// Operator-controlled runtime config: the transcription provider override
	// (see worker/providerOverride.ts). The id below is a placeholder — each deployment binds its
	// own namespace in the infra wrapper config. Replace it with a real id (or one from
	// `wrangler kv namespace create`) to exercise the override with `wrangler dev` / `cf:deploy`;
	// with no binding at all the Worker simply applies no override.
	"kv_namespaces": [
		{
			"binding": "CONFIG_KV",
			"id": "00000000000000000000000000000000"
		}
	],
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["Transcriptionator"]
		},
		{
			"tag": "v2",
			"deleted_classes": ["Transcriptionator"],
			"new_sqlite_classes": ["TranscriberContainer"]
		}
	],
	// Environment variables - add your secrets using wrangler secret put
	// See env.example for available configuration options
	"vars": {
		"FORCE_COMMIT_TIMEOUT": "2",
		"DEBUG": "true",
		"ROUTING_MODE": "session",
		"TRANSLATION_MIXING_MODE": "true"
	}
}
